WEBUI_PORT=3050
MAX_CONCURRENT_DOWNLOADS=2
# Host user UID/GID so downloaded files are owned by you, not root

PUID=1000
PGID=1000

# yt-dlp update channel: unset/stable checks weekly, nightly checks daily
# and installs pre-release builds — do this at your own risk.
#YTDLP_BRANCH=nightly

#Jellyfin config — required to use the Monitor tab; without it, only ad-hoc
#downloads work and they save straight to your browser.
JELLYFIN_URL=http://192.xxx:8096
JELLYFIN_API_KEY=<API-Key-Here>
JELLYFIN_MEDIA_PATH=<mnt/Media-Share>
